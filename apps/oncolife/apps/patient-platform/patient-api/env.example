# =============================================================================
# OncoLife Patient API - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================================================

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development          # development, staging, production
DEBUG=true                       # Enable debug mode
LOCAL_DEV_MODE=true              # Bypass Cognito auth for local development
LOG_LEVEL=DEBUG                  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=text                  # text (dev) or json (production)

# =============================================================================
# PATIENT DATABASE (Primary)
# =============================================================================
PATIENT_DB_HOST=localhost
PATIENT_DB_PORT=5432
PATIENT_DB_USER=oncolife_admin
PATIENT_DB_PASSWORD=your_password_here
PATIENT_DB_NAME=oncolife_patient

# =============================================================================
# DOCTOR DATABASE (Read-only access for cross-db queries)
# =============================================================================
DOCTOR_DB_HOST=localhost
DOCTOR_DB_PORT=5432
DOCTOR_DB_USER=oncolife_admin
DOCTOR_DB_PASSWORD=your_password_here
DOCTOR_DB_NAME=oncolife_doctor

# =============================================================================
# AWS CREDENTIALS
# =============================================================================
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# =============================================================================
# AWS COGNITO (Authentication)
# =============================================================================
COGNITO_USER_POOL_ID=us-west-2_xxxxxxxxx
COGNITO_CLIENT_ID=your_client_id_here
COGNITO_CLIENT_SECRET=your_client_secret_here

# =============================================================================
# AWS S3 (Document Storage)
# =============================================================================
S3_REFERRAL_BUCKET=oncolife-referrals
S3_EDUCATION_BUCKET=oncolife-education

# =============================================================================
# AWS SES (Email Notifications)
# =============================================================================
SES_SENDER_EMAIL=noreply@oncolife.com
SES_SENDER_NAME=OncoLife Care

# =============================================================================
# AWS SNS (SMS Notifications)
# =============================================================================
SNS_ENABLED=true
SNS_ALERT_TOPIC_ARN=arn:aws:sns:us-west-2:123456789:oncolife-alerts

# =============================================================================
# FAX SERVICE (Patient Onboarding)
# =============================================================================
FAX_INBOUND_NUMBER=+18001234567
FAX_WEBHOOK_SECRET=your_webhook_secret_here

# =============================================================================
# CORS SETTINGS
# =============================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# JWT SETTINGS (for local token validation)
# =============================================================================
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# OPTIONAL: External Services
# =============================================================================
# OpenAI (if using LLM features)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Slack Notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
